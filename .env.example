# AgroAI — Environment Variables Template
# ========================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file — it is git-ignored.

# ── Google Gemini AI ──────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here

# ── MongoDB Atlas ─────────────────────────────────────────────
# Create a free cluster at: https://cloud.mongodb.com
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/agroai?retryWrites=true&w=majority

# ── JWT Authentication ────────────────────────────────────────
# Use a strong random string (min 32 characters) — CHANGE IN PRODUCTION
JWT_SECRET_KEY=change_this_to_a_strong_random_secret_min_32_chars
JWT_ACCESS_TOKEN_EXPIRES=86400

# ── OpenWeatherMap (optional) ─────────────────────────────────
# Get a free key at: https://openweathermap.org/api
# If left empty, the system uses simulated weather data as fallback.
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
